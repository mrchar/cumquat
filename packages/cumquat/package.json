{
  "name": "@mrchar/cumquat",
  "version": "0.2.0",
  "description": "Vue 3 组件库：Headless 组合函数 + 默认渲染组件 + 语义化主题，逻辑与渲染解耦",
  "keywords": [
    "components",
    "headless",
    "tailwindcss",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/mrchar/cumquat#readme",
  "bugs": "https://github.com/mrchar/cumquat/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrchar/cumquat.git",
    "directory": "packages/cumquat"
  },
  "files": [
    "dist",
    "themes",
    "style.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./themes/*.css": "./themes/*.css",
    "./style.css": "./style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@cumquat/components": "workspace:*",
    "@cumquat/composables": "workspace:*",
    "@cumquat/themes": "workspace:*",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
