{
  "name": "@mrchar/cumquat",
  "version": "0.4.2",
  "description": "Vue 3 组件库：Headless 组合函数 + 默认渲染组件 + 语义化主题，逻辑与渲染解耦",
  "keywords": [
    "components",
    "headless",
    "tailwindcss",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/mrchar/cumquat#readme",
  "bugs": "https://github.com/mrchar/cumquat/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrchar/cumquat.git",
    "directory": "packages/cumquat"
  },
  "files": [
    "dist",
    "themes",
    "style.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes/*.css": "./themes/*.css",
    "./style.css": "./style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:assets && cross-env NODE_OPTIONS=--max-old-space-size=8192 vp pack",
    "build:assets": "node ./scripts/copy-assets.mjs && tailwindcss -i ./style-src.css -o ./style.css --minify"
  },
  "dependencies": {
    "@cumquat/composables": "workspace:*",
    "@cumquat/components": "workspace:*",
    "@cumquat/core": "workspace:*",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@vue/compiler-sfc": "^3.5.0",
    "shiki": "^4.5.0",
    "sucrase": "^3.35.1"
  },
  "bundledDependencies": [
    "@cumquat/composables",
    "@cumquat/components",
    "@cumquat/core"
  ],
  "devDependencies": {
    "@cumquat/themes": "workspace:*",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "cross-env": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
